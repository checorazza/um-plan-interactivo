# Copiá este archivo como `.env`.

# Origen de la API, SIN el /api final.
# En local, el Flask de al lado. En Vercel se deja vacío: el front y la API
# comparten dominio y las llamadas salen relativas.
VITE_API_URL=http://127.0.0.1:5000

# Client ID de Google OAuth, para el botón de "iniciar sesión" (fase 6).
# Si queda vacío, la app funciona igual: sólo se guarda en localStorage.
VITE_GOOGLE_CLIENT_ID=

# Puerto en el que se ejecuta la API
PORT=5000

# Ruta (relativa a backend/) donde se crea la base de datos
DATABASE_PATH=database

# Nombre del archivo de la base de datos
DATABASE_NAME=planinteractivo.db

# Opcional: URL completa de la base. Si está definida, ignora las dos anteriores.
# DATABASE_URL=postgresql://usuario:clave@host:5432/planinteractivo

# Clave secreta para firmar los JWT que emite la API. Poné algo largo y random.
JWT_SECRET_KEY=cambiame

# Tiempo de expiración del token de acceso, en segundos (por defecto, 7 días)
JWT_ACCESS_TOKEN_EXPIRES=604800

# Client ID de Google OAuth, para verificar los ID tokens del login
GOOGLE_CLIENT_ID=

# Orígenes autorizados para CORS, separados por coma
CORS_ORIGINS=
